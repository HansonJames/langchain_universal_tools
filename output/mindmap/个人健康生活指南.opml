<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>个人健康生活指南</title>
  </head>
  <body>
    <outline text="个人健康生活指南">
      <outline text="身体健康">
        <outline text="健康饮食">
          <outline text="均衡营养"/>
          <outline text="多样化食物选择"/>
          <outline text="控制盐糖摄入"/>
        </outline>
        <outline text="规律活动">
          <outline text="每天至少30分钟运动"/>
          <outline text="结合有氧与力量训练"/>
          <outline text="保持灵活性"/>
        </outline>
        <outline text="远离烟草">
          <outline text="戒烟计划"/>
          <outline text="减少二手烟暴露"/>
          <outline text="使用替代疗法"/>
        </outline>
      </outline>
      <outline text="精神健康">
        <outline text="心理平衡">
          <outline text="正念冥想"/>
          <outline text="情绪管理"/>
          <outline text="积极思维"/>
        </outline>
        <outline text="减轻压力">
          <outline text="时间管理"/>
          <outline text="休闲活动"/>
          <outline text="社交支持"/>
        </outline>
        <outline text="睡眠质量">
          <outline text="固定作息时间"/>
          <outline text="舒适的睡眠环境"/>
          <outline text="避免睡前刺激"/>
        </outline>
      </outline>
      <outline text="社会健康">
        <outline text="社交关系">
          <outline text="建立支持网络"/>
          <outline text="参与社区活动"/>
          <outline text="保持家庭联系"/>
        </outline>
        <outline text="社会责任">
          <outline text="志愿服务"/>
          <outline text="环境保护"/>
          <outline text="文化参与"/>
        </outline>
      </outline>
      <outline text="智力健康">
        <outline text="持续学习">
          <outline text="阅读书籍"/>
          <outline text="参加课程"/>
          <outline text="在线学习"/>
        </outline>
        <outline text="认知锻炼">
          <outline text="解谜游戏"/>
          <outline text="记忆训练"/>
          <outline text="逻辑思维"/>
        </outline>
      </outline>
      <outline text="情绪健康">
        <outline text="情感表达">
          <outline text="艺术创作"/>
          <outline text="日记书写"/>
          <outline text="情感交流"/>
        </outline>
        <outline text="情绪调节">
          <outline text="深呼吸练习"/>
          <outline text="情绪识别"/>
          <outline text="情绪释放"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
